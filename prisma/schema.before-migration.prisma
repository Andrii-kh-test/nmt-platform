generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Test {
  id           Int           @id @default(autoincrement())
  title        String
  subject      String
  description  String?
  schoolYear   String
  duration     Int
  maxPoints    Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accessCode   String?
  codeRequired Boolean       @default(true)
  isPublished  Boolean       @default(false)
  examType     String        @default("НМТ")
  displayOrder Int           @unique
  Question     Question[]
  results      TestResult[]
  sessions     TestSession[]
}

model Question {
  id              Int            @id @default(autoincrement())
  order           Int
  type            String
  text            String
  points          Int
  testId          Int
  shuffleQuestion Boolean        @default(true)
  answerOptions   AnswerOption[]
  Test            Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model AnswerOption {
  id         Int      @id @default(autoincrement())
  order      Int
  text       String
  isCorrect  Boolean
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Participant {
  id         Int           @id @default(autoincrement())
  lastName   String
  firstName  String
  middleName String?
  createdAt  DateTime      @default(now())
  sessions   TestSession[]
}

model TestSession {
  id              Int          @id @default(autoincrement())
  testId          Int
  currentQuestion Int          @default(0)
  savedAnswers    Json
  timeLeft        Int
  finished        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  participantId   Int?
  blockReason     String?
  blocked         Boolean      @default(false)
  extraTime       Int          @default(0)
  finishedAt      DateTime?
  startedAt       DateTime     @default(now())
  blockedAt       DateTime?
  lastActivityAt  DateTime     @default(now())
  participant     Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  test            Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestResult {
  id           Int       @id @default(autoincrement())
  testId       Int
  earnedPoints Int
  maxPoints    Int
  percent      Int
  correct      Int
  incorrect    Int
  skipped      Int
  timeSpent    Int
  answers      Json
  finishReason String    @default("manual")
  createdAt    DateTime  @default(now())
  firstName    String?
  lastName     String?
  middleName   String?
  accessCode   String?
  finishedAt   DateTime?
  startedAt    DateTime?
  test         Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
}
