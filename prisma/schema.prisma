generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Test {
  id           Int               @id @default(autoincrement())
  title        String
  subject      String
  subjectId    Int?
  subjectRef   Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  description  String?
  schoolYear   String
  duration     Int
  maxPoints    Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  accessCode   String?
  codeRequired Boolean           @default(true)
  isPublished  Boolean           @default(false)
  examType     String            @default("НМТ")
  displayOrder Int               @unique
  isArchived   Boolean           @default(false)

  questions    TestQuestion[]
  results      TestResult[]
  sessions     TestSession[]
  complexTests ComplexTestItem[]
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)

  tests       Test[]
}

model ComplexTest {
  id           Int               @id @default(autoincrement())
  title        String
  description  String?
  duration     Int
  accessCode   String?
  codeRequired Boolean           @default(true)
  isPublished  Boolean           @default(false)
  isArchived   Boolean           @default(false)
  examType     String            @default("НМТ")
  section      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tests        ComplexTestItem[]
  sessions     ComplexTestSession[]
}

model ComplexTestItem {
  id            Int         @id @default(autoincrement())
  complexTestId Int
  testId        Int
  order         Int

  complexTest   ComplexTest @relation(fields: [complexTestId], references: [id], onDelete: Cascade)
  test          Test        @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([complexTestId, testId])
  @@index([complexTestId, order])
  @@index([testId])
}

model Question {
  id              Int            @id @default(autoincrement())
  type            String
  text            String
  points          Int
  shuffleQuestion Boolean        @default(true)

  answerOptions   AnswerOption[]
  tests           TestQuestion[]
}

model TestQuestion {
  id         Int      @id @default(autoincrement())
  testId     Int
  questionId Int
  order      Int

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([testId, order])
  @@index([questionId])
}

model AnswerOption {
  id         Int      @id @default(autoincrement())
  order      Int
  text       String
  isCorrect  Boolean
  questionId Int

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Participant {
  id         Int           @id @default(autoincrement())
  lastName   String
  firstName  String
  middleName String?
  createdAt  DateTime      @default(now())
  accessCode String?

  sessions        TestSession[]
  complexSessions ComplexTestSession[]
}

model TestSession {
  id              Int          @id @default(autoincrement())
  testId          Int
  currentQuestion Int          @default(0)
  savedAnswers    Json
  timeLeft        Int
  finished        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  participantId   Int?
  blockReason     String?
  blocked         Boolean      @default(false)
  extraTime       Int          @default(0)
  finishedAt      DateTime?
  startedAt       DateTime?    @default(now())
  blockedAt       DateTime?
  lastActivityAt  DateTime     @default(now())

  result          TestResult?
  participant     Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  test            Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model ComplexTestSession {
  id              Int         @id @default(autoincrement())
  complexTestId   Int
  participantId   Int?

  currentTestId   Int?
  currentQuestion Int        @default(0)

  savedAnswers    Json
  timeLeft        Int

  finished        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  finishedAt      DateTime?
  startedAt       DateTime?   @default(now())

  blockReason     String?
  blocked         Boolean     @default(false)
  extraTime       Int         @default(0)
  blockedAt       DateTime?
  lastActivityAt  DateTime    @default(now())

  participant     Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  complexTest     ComplexTest  @relation(fields: [complexTestId], references: [id], onDelete: Cascade)

  @@index([complexTestId])
  @@index([participantId])
}

model TestResult {
  id           Int          @id @default(autoincrement())
  testId       Int
  earnedPoints Int
  maxPoints    Int
  percent      Int
  correct      Int
  incorrect    Int
  skipped      Int
  timeSpent    Int
  answers      Json
  finishReason String       @default("manual")
  createdAt    DateTime     @default(now())
  firstName    String?
  lastName     String?
  middleName   String?
  accessCode   String?
  finishedAt   DateTime?
  startedAt    DateTime?
  sessionId    Int?         @unique

  session      TestSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  test         Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
}