generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Test {
  id          Int     @id @default(autoincrement())
  title       String
  subject     String
  description String?
  schoolYear  String
  duration    Int
  maxPoints   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]

  results TestResult[]

  sessions TestSession[]
}

model Question {
  id     Int    @id @default(autoincrement())
  order  Int
  type   String
  text   String
  points Int

  testId Int
  test   Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  options AnswerOption[]
}

model AnswerOption {
  id        Int     @id @default(autoincrement())
  order     Int
  text      String
  isCorrect Boolean

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TestResult {
  id Int @id @default(autoincrement())

  testId Int
  test   Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  earnedPoints Int
  maxPoints    Int
  percent      Int

  correct   Int
  incorrect Int
  skipped   Int

  timeSpent Int

  answers Json

  /// manual | timeout | security
  finishReason String @default("manual")

  createdAt DateTime @default(now())
}

model TestSession {
  id Int @id @default(autoincrement())

  testId Int
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  currentQuestion Int @default(0)

  savedAnswers Json

  timeLeft Int

  finished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}