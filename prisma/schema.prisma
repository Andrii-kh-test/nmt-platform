generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Test {
  id          Int      @id @default(autoincrement())
  title       String
  subject     String
  description String?
  schoolYear  String
  duration    Int
  maxPoints   Int

  /// Публікація тесту
  isPublished Boolean @default(false)

  /// Чи потрібен код доступу
  codeRequired Boolean @default(true)

  /// Код доступу
  accessCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  results   TestResult[]
  sessions  TestSession[]
}

model Question {
  id     Int    @id @default(autoincrement())
  order  Int
  type   String
  text   String
  points Int

  testId Int
  test   Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  options AnswerOption[]
}

model AnswerOption {
  id        Int     @id @default(autoincrement())
  order     Int
  text      String
  isCorrect Boolean

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Participant {
  id Int @id @default(autoincrement())

  lastName   String
  firstName  String
  middleName String?

  createdAt DateTime @default(now())

  sessions TestSession[]
}

model TestSession {
  id Int @id @default(autoincrement())

  participantId Int?
  participant Participant?
    @relation(fields: [participantId], references: [id], onDelete: Cascade)

  testId Int
  test Test
    @relation(fields: [testId], references: [id], onDelete: Cascade)

  currentQuestion Int @default(0)

  savedAnswers Json

  timeLeft Int

  finished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestResult {
  id Int @id @default(autoincrement())

  testId Int
  test Test
    @relation(fields: [testId], references: [id], onDelete: Cascade)

  /// Дані учасника
  lastName   String?
  firstName  String?
  middleName String?

  earnedPoints Int
  maxPoints    Int
  percent      Int

  correct   Int
  incorrect Int
  skipped   Int

  timeSpent Int

  answers Json

  /// manual | timeout | security
  finishReason String @default("manual")

  createdAt DateTime @default(now())
}